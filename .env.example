# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection URI
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zemifix_cmms?schema=public"

# Initial admin user bootstrap (Required for database seeding; minimum 12 characters)
INITIAL_ADMIN_EMAIL="admin@yourcompany.com"
INITIAL_ADMIN_PASSWORD="REPLACE_WITH_YOUR_SECURE_PASSWORD_MIN_12_CHARS"

# SESSION_SECRET: Required in production for signing session JWT tokens (minimum 32 characters)
SESSION_SECRET="REPLACE_WITH_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"

