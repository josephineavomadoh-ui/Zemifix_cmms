# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection URI
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zemifix_cmms?schema=public"

# Initial admin user bootstrap
INITIAL_ADMIN_EMAIL="admin@zemifix.local"
INITIAL_ADMIN_PASSWORD="ReplaceWithStrongAdminPassword!"
