# ZemiFix CMMS Environment Configuration Example
# Primary Operating Timezone: Africa/Accra

NODE_ENV=production
DATABASE_URL=postgresql://user:password@localhost:5432/zemifix_prod?schema=public
SESSION_SECRET=your-super-secure-session-secret-at-least-32-chars-long
OTP_SECRET=your-super-secure-otp-secret-at-least-32-chars-long
PORTAL_SESSION_SECRET=your-super-secure-portal-secret-at-least-32-chars-long
APPROVAL_SECRET=your-super-secure-approval-secret-at-least-32-chars-long
WORKER_SECRET=your-super-secure-worker-secret-at-least-32-chars-long
NEXT_PUBLIC_APP_URL=https://cmms.zemifix.local
RESEND_API_KEY=re_your_resend_api_key_here
OTP_FROM_EMAIL=no-reply@zemifix.local
TZ=Africa/Accra
