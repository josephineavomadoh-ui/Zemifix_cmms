// 72. Customer Commercial Quotation Master
model Quote {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quoteNumber          String            @db.VarChar(50)
  version              Int               @default(1) @db.Integer
  customerId           String            @db.Uuid
  customer             Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  siteId               String?           @db.Uuid
  site                 CustomerSite?     @relation(fields: [siteId], references: [id], onDelete: Restrict)
  workRequestId        String?           @db.Uuid
  workRequest          WorkRequest?      @relation(fields: [workRequestId], references: [id], onDelete: SetNull)
  workOrderId          String?           @db.Uuid
  workOrder            WorkOrder?        @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  title                String            @db.VarChar(150)
  currency             String            @default("GHS") @db.Char(3)
  taxScheme            String            @default("GHANA_STATUTORY_2026") @db.VarChar(50)
  taxInclusive         Boolean           @default(false)
  subtotal             Decimal           @default(0.00) @db.Decimal(14, 2)
  vatRate              Decimal           @default(0.15) @db.Decimal(5, 4)
  vatAmount            Decimal           @default(0.00) @db.Decimal(14, 2)
  nhilRate             Decimal           @default(0.025) @db.Decimal(5, 4)
  nhilAmount           Decimal           @default(0.00) @db.Decimal(14, 2)
  getFundRate          Decimal           @default(0.025) @db.Decimal(5, 4)
  getFundAmount        Decimal           @default(0.00) @db.Decimal(14, 2)
  totalAmount          Decimal           @default(0.00) @db.Decimal(14, 2)
  status               QuoteStatus       @default(DRAFT)
  validUntil           DateTime?         @db.Date
  createdByUserId      String            @db.Uuid
  createdByUser        User              @relation("QuoteCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  approvedByUserId     String?           @db.Uuid
  approvedByUser       User?             @relation("QuoteInternalApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  approvalRequestId    String?           @db.Uuid
  approvalRequest      ApprovalRequest?  @relation(fields: [approvalRequestId], references: [id], onDelete: SetNull)
  createdAt            DateTime          @default(now()) @db.Timestamptz
  updatedAt            DateTime          @updatedAt @db.Timestamptz
  deletedAt            DateTime?         @db.Timestamptz

  lines                QuoteLine[]
  versionHistory       QuoteVersionHistory[]
  decisionLogs         QuoteDecisionLog[]
  invoices             Invoice[]

  @@unique([quoteNumber, version]) // Enforces unique quote versioning at database level
  @@index([customerId])
  @@index([workOrderId])
  @@index([status])
  @@map("quotes")
}

