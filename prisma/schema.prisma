  contract             CustomerContract? @relation(fields: [contractId], references: [id], onDelete: Restrict)
  quoteId              String?           @db.Uuid
  quote                Quote?            @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  workOrderId          String?           @db.Uuid
  workOrder            WorkOrder?        @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  issueDate            DateTime          @default(now()) @db.Date
  dueDate              DateTime          @db.Date
  sentAt               DateTime?         @db.Timestamptz
  currency             String            @default("GHS") @db.Char(3)
  taxScheme            String            @default("GHANA_STATUTORY_2026") @db.VarChar(50)
  taxInclusive         Boolean           @default(false)
  subtotal             Decimal           @default(0.00) @db.Decimal(14, 2)
  vatRate              Decimal           @default(0.15) @db.Decimal(5, 4)
  vatAmount            Decimal           @default(0.00) @db.Decimal(14, 2)
  nhilRate             Decimal           @default(0.025) @db.Decimal(5, 4)
  nhilAmount           Decimal           @default(0.00) @db.Decimal(14, 2)
  getFundRate          Decimal           @default(0.025) @db.Decimal(5, 4)
  getFundAmount        Decimal           @default(0.00) @db.Decimal(14, 2)
  totalAmount          Decimal           @default(0.00) @db.Decimal(14, 2)
  paidAmount           Decimal           @default(0.00) @db.Decimal(14, 2)
  creditedAmount       Decimal           @default(0.00) @db.Decimal(14, 2)
  balanceDue           Decimal           @default(0.00) @db.Decimal(14, 2)
  status               InvoiceStatus     @default(DRAFT)
  createdByUserId      String            @db.Uuid
  createdByUser        User              @relation("InvoiceCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  approvedByUserId     String?           @db.Uuid
  approvedByUser       User?             @relation("InvoiceApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  approvalRequestId    String?           @db.Uuid
  approvalRequest      ApprovalRequest?  @relation(fields: [approvalRequestId], references: [id], onDelete: Restrict)
  createdAt            DateTime          @default(now()) @db.Timestamptz
  updatedAt            DateTime          @updatedAt @db.Timestamptz
  deletedAt            DateTime?         @db.Timestamptz

  lines                InvoiceLine[]
  allocations          PaymentAllocation[]
  creditNotes          CreditNote[]

  @@index([customerId])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}

// 81. Invoice Line Items
model InvoiceLine {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId       String      @db.Uuid
  invoice         Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  workOrderId     String?     @db.Uuid
  workOrder       WorkOrder?  @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  partId          String?     @db.Uuid
  part            Part?       @relation(fields: [partId], references: [id], onDelete: SetNull)
  description     String      @db.VarChar(200)
  quantity        Decimal     @db.Decimal(14, 2)
  unitPrice       Decimal     @db.Decimal(14, 2)
  discountAmount  Decimal     @default(0.00) @db.Decimal(14, 2)
  lineTotal       Decimal     @db.Decimal(14, 2)

  @@index([invoiceId])
  @@map("invoice_lines")
}

// 82. Customer Payment Remittances
model Payment {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentNumber     String            @unique @db.VarChar(50)
  customerId        String            @db.Uuid
  customer          Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  amount            Decimal           @db.Decimal(14, 2)
  unallocatedAmount Decimal           @db.Decimal(14, 2)
  paymentMethod     PaymentMethod     @default(BANK_TRANSFER)
  referenceNumber   String?           @db.VarChar(100) // Cheque # / MoMo Ref / Txn Hash
  paymentDate       DateTime          @default(now()) @db.Date
  notes             String?           @db.Text
  recordedByUserId  String            @db.Uuid
  recordedByUser    User              @relation(fields: [recordedByUserId], references: [id], onDelete: Restrict)
  createdAt         DateTime          @default(now()) @db.Timestamptz

  allocations       PaymentAllocation[]
  reversals         PaymentReversal[]

  @@index([customerId])
  @@index([paymentDate])
  @@map("payments")
}

// 83. Payment Allocation Ledger (Remittance to Invoice)
model PaymentAllocation {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId        String   @db.Uuid
  payment          Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoiceId        String   @db.Uuid
  invoice          Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amountAllocated  Decimal  @db.Decimal(14, 2)
  allocatedAt      DateTime @default(now()) @db.Timestamptz

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
  @@map("payment_allocations")
}

// 84. Payment Reversal Ledger
model PaymentReversal {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId        String   @db.Uuid
  payment          Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  amountReversed   Decimal  @db.Decimal(14, 2)
  reason           String   @db.Text
  reversedAt       DateTime @default(now()) @db.Timestamptz

  @@index([paymentId])
  @@map("payment_reversals")
}

// 85. Credit Notes
model CreditNote {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creditNoteNumber String           @unique @db.VarChar(50)
  invoiceId        String           @db.Uuid
  invoice          Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  customerId       String           @db.Uuid
  customer         Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  reason           String           @db.Text
  subtotal         Decimal          @db.Decimal(14, 2)
  vatAmount        Decimal          @default(0.00) @db.Decimal(14, 2)
  nhilAmount       Decimal          @default(0.00) @db.Decimal(14, 2)
  getFundAmount    Decimal          @default(0.00) @db.Decimal(14, 2)
  totalAmount      Decimal          @db.Decimal(14, 2)
  status           CreditNoteStatus @default(DRAFT)
  approvalRequestId String?         @db.Uuid
  approvalRequest  ApprovalRequest? @relation(fields: [approvalRequestId], references: [id], onDelete: Restrict)
  issuedByUserId   String           @db.Uuid
  issuedByUser     User             @relation(fields: [issuedByUserId], references: [id], onDelete: Restrict)
  createdAt        DateTime         @default(now()) @db.Timestamptz

  lines            CreditNoteLine[]

  @@index([invoiceId])
  @@index([customerId])
  @@map("credit_notes")
}

// 86. Credit Note Line Items
model CreditNoteLine {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creditNoteId    String     @db.Uuid
  creditNote      CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  description     String     @db.VarChar(200)
  quantity        Decimal    @db.Decimal(14, 2)
  unitPrice       Decimal    @db.Decimal(14, 2)
  lineTotal       Decimal    @db.Decimal(14, 2)

  @@index([creditNoteId])
  @@map("credit_note_lines")
}

enum NotificationRealm {
  STAFF
  CUSTOMER
}

enum NotificationDeliveryStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

enum NotificationAttemptStatus {
  STARTED
  SENT
  FAILED
}

model Notification {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  realm              NotificationRealm
  recipientUserId    String?           @db.Uuid
  recipientUser      User?             @relation("StaffNotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  recipientContactId String?           @db.Uuid
  recipientContact   CustomerContact?  @relation("PortalNotificationRecipient", fields: [recipientContactId], references: [id], onDelete: Cascade)
  customerId         String?           @db.Uuid
  siteId             String?           @db.Uuid
  branchId           String?           @db.Uuid
  departmentId       String?           @db.Uuid
  eventType          String            @db.VarChar(60)
  idempotencyKey     String            @unique @db.VarChar(200)
  title              String            @db.VarChar(180)
  body               String            @db.Text
  link               String?           @db.VarChar(500)
  emailSubject       String            @db.VarChar(180)
  emailBody          String            @db.Text
  data               Json              @default("{}")
  inAppEnabled       Boolean           @default(true)
  createdAt          DateTime          @default(now()) @db.Timestamptz
  readAt             DateTime?         @db.Timestamptz
  emailDelivery      NotificationEmailDelivery?

  @@index([recipientUserId, readAt, createdAt])
  @@index([recipientContactId, readAt, createdAt])
  @@index([customerId, siteId])
  @@map("notifications")
}

model NotificationPreference {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientUserId    String?          @db.Uuid
  recipientUser      User?            @relation("StaffNotificationPreference", fields: [recipientUserId], references: [id], onDelete: Cascade)
  recipientContactId String?          @db.Uuid
  recipientContact   CustomerContact? @relation("PortalNotificationPreference", fields: [recipientContactId], references: [id], onDelete: Cascade)
  eventType          String           @db.VarChar(60)
  inAppEnabled       Boolean          @default(true)
  emailEnabled       Boolean          @default(true)
  updatedAt          DateTime         @updatedAt @db.Timestamptz

  @@unique([recipientUserId, eventType])
  @@unique([recipientContactId, eventType])
  @@map("notification_preferences")
}

model NotificationTemplate {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  realm             NotificationRealm
  eventType         String            @db.VarChar(60)
  titleTemplate     String            @db.VarChar(180)
  bodyTemplate      String            @db.Text
  emailSubject      String            @db.VarChar(180)
  emailBody         String            @db.Text
  isActive          Boolean           @default(true)
  updatedAt         DateTime          @updatedAt @db.Timestamptz

  @@unique([realm, eventType])
  @@map("notification_templates")
}

model NotificationEmailDelivery {
  id                String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificationId    String                     @unique @db.Uuid
  notification      Notification               @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  status            NotificationDeliveryStatus @default(PENDING)
  attemptCount      Int                        @default(0)
  maxAttempts       Int                        @default(5)
  nextAttemptAt     DateTime                   @default(now()) @db.Timestamptz
  lockedAt          DateTime?                  @db.Timestamptz
  sentAt            DateTime?                  @db.Timestamptz
  lastError         String?                    @db.Text
  providerMessageId String?                    @db.VarChar(255)
  createdAt         DateTime                   @default(now()) @db.Timestamptz
  updatedAt         DateTime                   @updatedAt @db.Timestamptz
  attempts          NotificationDeliveryAttempt[]

  @@index([status, nextAttemptAt])
  @@map("notification_email_deliveries")
}

model NotificationDeliveryAttempt {
  id                String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deliveryId        String                    @db.Uuid
  delivery          NotificationEmailDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  attemptNumber     Int
  status            NotificationAttemptStatus @default(STARTED)
  attemptedAt       DateTime                  @default(now()) @db.Timestamptz
  completedAt       DateTime?                 @db.Timestamptz
  error             String?                   @db.Text
  providerMessageId String?                   @db.VarChar(255)

  @@unique([deliveryId, attemptNumber])
  @@index([deliveryId, attemptedAt])
  @@map("notification_delivery_attempts")
}

// 87. Facility Mode Internal Departmental Recharges
model InternalRecharge {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rechargeNumber   String      @unique @db.VarChar(50)
  workOrderId      String      @db.Uuid
  workOrder        WorkOrder   @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  fromDepartmentId String      @db.Uuid
  fromDepartment   Department  @relation("RechargeFromDept", fields: [fromDepartmentId], references: [id], onDelete: Restrict)
  toDepartmentId   String      @db.Uuid
  toDepartment     Department  @relation("RechargeToDept", fields: [toDepartmentId], references: [id], onDelete: Restrict)
  amount           Decimal     @db.Decimal(14, 2)
  description      String      @db.Text
  rechargeDate     DateTime    @default(now()) @db.Date
  recordedByUserId String      @db.Uuid
  recordedByUser   User        @relation(fields: [recordedByUserId], references: [id], onDelete: Restrict)
  createdAt        DateTime    @default(now()) @db.Timestamptz

  @@unique([workOrderId]) // Enforces exactly one internal recharge per work order
  @@index([workOrderId])
  @@index([fromDepartmentId])
  @@index([toDepartmentId])
  @@map("internal_recharges")
}

// 88. Import Batch & History Ledger
model ImportBatch {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType    String    @db.VarChar(50)
  status        String    @db.VarChar(30)
  fileName      String    @db.VarChar(255)
  contentHash   String?   @db.VarChar(64)
  mappingHash   String?   @db.VarChar(64)
  workerId      String?   @db.VarChar(100)
  startedAt     DateTime? @db.Timestamptz
  expiresAt     DateTime? @db.Timestamptz
  totalRows     Int       @default(0)
  successRows   Int       @default(0)
  errorRows     Int       @default(0)
  actorUserId   String    @db.Uuid
  actorUser     User      @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  summaryJson   Json?
  errorsJson    Json?
  mappingJson   Json?
  createdAt     DateTime  @default(now()) @db.Timestamptz
  updatedAt     DateTime  @updatedAt @db.Timestamptz

  @@unique([contentHash, entityType, mappingHash])
  @@index([entityType])
  @@index([actorUserId])
  @@map("import_batches")
}

// 89. Distributed Rate Limiting
model RateLimit {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key             String   @unique @db.VarChar(200)
  hitCount        Int      @default(1)
  windowExpiresAt DateTime @db.Timestamptz
  createdAt       DateTime @default(now()) @db.Timestamptz
  updatedAt       DateTime @updatedAt @db.Timestamptz

  @@index([windowExpiresAt])
  @@map("rate_limits")
}

// 90. Centralized Background Jobs & Execution Leases
model BackgroundJob {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobType         String    @db.VarChar(60)
  status          String    @db.VarChar(30) @default("PENDING")
  payload         Json      @default("{}")
  result          Json?
  retryCount      Int       @default(0)
  maxRetries      Int       @default(5)
  workerId        String?   @db.VarChar(100)
  startedAt       DateTime? @db.Timestamptz
  expiresAt       DateTime? @db.Timestamptz
  completedAt     DateTime? @db.Timestamptz
  lastError       String?   @db.Text
  idempotencyKey  String    @unique @db.VarChar(200)
  createdAt       DateTime  @default(now()) @db.Timestamptz
  updatedAt       DateTime  @updatedAt @db.Timestamptz

  @@index([status, jobType])
  @@index([status, jobType, expiresAt, createdAt])
  @@index([expiresAt])
  @@map("background_jobs")
}

// 91. Background Workers & Heartbeat Monitoring
model BackgroundWorker {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workerId        String    @unique @db.VarChar(100)
  status          String    @db.VarChar(30) @default("ACTIVE")
  currentJobId    String?   @db.Uuid
  lastHeartbeatAt DateTime  @default(now()) @db.Timestamptz
  createdAt       DateTime  @default(now()) @db.Timestamptz
  updatedAt       DateTime  @updatedAt @db.Timestamptz

  @@map("background_workers")
}

