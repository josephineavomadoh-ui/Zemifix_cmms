// ====================================================
// STAGE R1: TECHNICIAN PWA & OFFLINE SYNCHRONIZATION
// ====================================================

enum SyncBatchStatus {
  PROCESSING
  COMPLETED
  PARTIALLY_COMPLETED
  FAILED
}

enum SyncMutationStatus {
  QUEUED
  PROCESSING
  SYNCED
  CONFLICT
  FAILED
}

enum SyncConflictType {
  WO_CANCELLED
  WO_REASSIGNED
  WO_STATUS_MISMATCH
  WO_NOT_ACCESSIBLE
  CHECKLIST_ALREADY_COMPLETED
  STOCK_UNAVAILABLE
  STALE_VERSION
}

// 61. Offline Sync Batch Envelopes
model OfflineSyncBatch {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchRef       String          @unique @db.VarChar(50)
  userId         String          @db.Uuid
  user           User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  status         SyncBatchStatus @default(PROCESSING)
  mutationCount  Int             @default(0)
  syncedCount    Int             @default(0)
  conflictCount  Int             @default(0)
  failedCount    Int             @default(0)
  processedAt    DateTime?       @db.Timestamptz
  createdAt      DateTime        @default(now()) @db.Timestamptz

  mutations      OfflineSyncMutation[]

  @@index([userId])
  @@index([status])
  @@map("offline_sync_batches")
}

// 62. Queued Offline Mutations (Database-Level Idempotency)
model OfflineSyncMutation {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchId                String             @db.Uuid
  batch                  OfflineSyncBatch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  userId                 String             @db.Uuid
  user                   User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  idempotencyKey         String             @db.VarChar(100) // UUIDv7 generated on client
  actionType             String             @db.VarChar(50)  // WORK_ORDER_STATUS_SHIFT, CHECKLIST_UPDATE, LABOR_LOG, etc.
  entityType             String             @db.VarChar(50)  // work_order, checklist_item, labor, etc.
  entityId               String             @db.Uuid
  payload                Json
  status                 SyncMutationStatus @default(QUEUED)
  processingLeaseExpiresAt DateTime?        @db.Timestamptz // Lease timeout for crash recovery
  errorMessage           String?            @db.Text
  conflictReason         String?            @db.Text
  processedAt            DateTime?          @db.Timestamptz
  createdAt              DateTime           @default(now()) @db.Timestamptz

  conflicts              OfflineSyncConflict[]

  @@unique([userId, idempotencyKey]) // Database-Level Idempotency Guard across concurrent retries
  @@index([batchId])
  @@index([status])
  @@map("offline_sync_mutations")
}

// 63. Concurrency Conflict Review Ledger
model OfflineSyncConflict {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mutationId         String              @db.Uuid
  mutation           OfflineSyncMutation @relation(fields: [mutationId], references: [id], onDelete: Restrict)
  userId             String              @db.Uuid
  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  conflictType       SyncConflictType
  clientState        Json
  serverState        Json
  resolutionStrategy String              @default("SERVER_WINS") @db.VarChar(50)
  resolvedByUserId   String?             @db.Uuid
  resolvedByUser     User?               @relation("ConflictResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  resolvedAt         DateTime?           @db.Timestamptz
  createdAt          DateTime            @default(now()) @db.Timestamptz

  @@index([mutationId])
  @@index([userId])
  @@map("offline_sync_conflicts")
}

