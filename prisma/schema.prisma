  actualElapsedMinutes Int              @db.Integer
  breachedAt           DateTime         @default(now()) @db.Timestamptz

  @@unique([workOrderId, breachType, slaCycle]) // Cycle-aware uniqueness constraint
  @@index([workOrderId])
  @@index([breachedAt])
  @@map("sla_breach_logs")
}

